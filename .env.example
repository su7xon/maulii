# VITE_GROQ_API_KEY: Groq API key for the Mauli Mobile chatbot.
# Get one free at https://console.groq.com — copy .env.example to .env and paste your key.
VITE_GROQ_API_KEY="MY_GROQ_API_KEY"

# VITE_FIREBASE_*: Firebase config for Google sign-in + shared images (Storage + Firestore).
# Firebase Console → Project settings → Your apps → Web app → copy these values.
# Also enable:
#  1. Authentication → Sign-in method → Google, + Authorized domains (localhost + Netlify URL)
#  2. Storage → Get started → rules: allow read; allow write if request.auth != null (ya test mode)
#  3. Firestore Database → Create database → collection "stores", doc "mauli-store" auto-banega
# Bina keys ke app localStorage mode me chalega (upload sirf same browser me dikhega).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# VITE_RAZORPAY_KEY_ID: Razorpay Key ID (PUBLIC — bundle me jaata hai, isme koi problem nahi).
# Razorpay Dashboard → Account & Settings → API Keys → Generate Key.
# Test key "rzp_test_..." se shuru hoti hai, live "rzp_live_...".
# IMPORTANT: Key SECRET kabhi yahan nahi. Woh Netlify env var RAZORPAY_KEY_SECRET me
# jaati hai (netlify/functions/razorpay.ts use karta hai). Bina id ke online
# payment off rehta hai aur checkout sirf COD dikhata hai.
VITE_RAZORPAY_KEY_ID=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
