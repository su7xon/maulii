# VITE_GROQ_API_KEY: Groq API key for the Mauli Mobile chatbot.
# Get one free at https://console.groq.com — copy .env.example to .env and paste your key.
VITE_GROQ_API_KEY="MY_GROQ_API_KEY"

# VITE_FIREBASE_*: Firebase config for Google sign-in on the Account page.
# Firebase Console → Project settings → Your apps → Web app → copy these values.
# Also enable Authentication → Sign-in method → Google, and add your domain
# (e.g. http://localhost:3000) under Authentication → Settings → Authorized domains.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
